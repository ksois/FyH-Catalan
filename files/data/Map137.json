",0,0,0]},{"code":401,"indent":0,"parameters":["\\c[7]\\N[3]\\c[0]"]},{"code":401,"indent":0,"parameters":["\"Però en realitat, moltes coses de la profecia són "]},{"code":401,"indent":0,"parameters":["sorprenentment precises.\""]},{"code":101,"indent":0,"parameters":["",0,0,0]},{"code":401,"indent":0,"parameters":["\\c[7]\\N[3]\\c[0]"]},{"code":401,"indent":0,"parameters":["\"Parla sobre 'l'home de cabell clar' i 'aquell que "]},{"code":401,"indent":0,"parameters":["s'assembla als déus en poder i bellesa'...\""]},{"code":101,"indent":0,"parameters":["",0,0,0]},{"code":401,"indent":0,"parameters":["\\c[7]\\N[6]\\c[0]"]},{"code":401,"indent":0,"parameters":["\"Ha! Pensava que tots els déus antics eren "]},{"code":401,"indent":0,"parameters":["asquerosament lleigs.\""]},{"code":101,"indent":0,"parameters":["",0,0,0]},{"code":401,"indent":0,"parameters":["\\c[7]\\N[6]\\c[0]"]},{"code":401,"indent":0,"parameters":["\"No em diguis que tu també creus en aquestes coses?\""]},{"code":101,"indent":0,"parameters":["",0,0,0]},{"code":401,"indent":0,"parameters":["\\c[7]\\N[3]\\c[0]"]},{"code":401,"indent":0,"parameters":["\"Se suposa que Nilvan, dels nous déus, és bonica. "]},{"code":401,"indent":0,"parameters":["Igual que l'atormentat solia ser-ho.\""]},{"code":230,"indent":0,"parameters":[80]},{"code":101,"indent":0,"parameters":["",0,0,0]},{"code":401,"indent":0,"parameters":["\\c[7]\\N[3]\\c[0]"]},{"code":401,"indent":0,"parameters":["\"Els textos també parlen de 'Ell, qui uneix els estats en "]},{"code":401,"indent":0,"parameters":["guerra, no pel poder del bastó daurat, sinó pel poder "]},{"code":401,"indent":0,"parameters":["d'una dotzena de forques'.\""]},{"code":101,"indent":0,"parameters":["",0,0,0]},{"code":401,"indent":0,"parameters":["\\c[7]\\N[6]\\c[0]"]},{"code":401,"indent":0,"parameters":["\"Bé, en aquest punt tots els reis m'odien, així que en "]},{"code":401,"indent":0,"parameters":["aquesta línia puc estar d'acord...\""]},{"code":230,"indent":0,"parameters":[80]},{"code":101,"indent":0,"parameters":["",0,0,0]},{"code":401,"indent":0,"parameters":["\\c[7]\\N[6]\\c[0]"]},{"code":401,"indent":0,"parameters":["\"M'ESFORÇARÉ per unificar aquestes terres, tant si és a "]},{"code":401,"indent":0,"parameters":["les profecies com si no.\""]},{"code":101,"indent":0,"parameters":["",0,0,0]},{"code":401,"indent":0,"parameters":["\\c[7]\\N[6]\\c[0]"]},{"code":401,"indent":0,"parameters":["\"No importa el cost.\""]},{"code":230,"indent":0,"parameters":[80]},{"code":101,"indent":0,"parameters":["",0,0,0]},{"code":401,"indent":0,"parameters":["\\c[7]\\N[6]\\c[0]"]},{"code":401,"indent":0,"parameters":["\"Però...\""]},{"code":101,"indent":0,"parameters":["",0,0,0]},{"code":401,"indent":0,"parameters":["\\c[7]\\N[6]\\c[0]"]},{"code":401,"indent":0,"parameters":["\"Sento que estic molt a prop d'assolir les meves metes, però el "]},{"code":401,"indent":0,"parameters":["darrer pas no és clar... Encara està embolcallat en la boira.\""]},{"code":101,"indent":0,"parameters":["",0,0,0]},{"code":401,"indent":0,"parameters":["\\c[7]\\N[6]\\c[0]"]},{"code":401,"indent":0,"parameters":["\"No estic segur si aquest és 'el camí' per aconseguir tot "]},{"code":401,"indent":0,"parameters":["això.\""]},{"code":230,"indent":0,"parameters":[80]},{"code":101,"indent":0,"parameters":["",0,0,0]},{"code":401,"indent":0,"parameters":["\\c[7]\\N[3]\\c[0]"]},{"code":401,"indent":0,"parameters":["\"Què vols dir? Estàs a només un pas de fundar el teu "]},{"code":401,"indent":0,"parameters":["propi regne i convertir-te en un dels governants més "]},{"code":401,"indent":0,"parameters":["llegendaris de la nostra època!\""]},{"code":101,"indent":0,"parameters":["",0,0,0]},{"code":401,"indent":0,"parameters":["\\c[7]\\N[3]\\c[0]"]},{"code":401,"indent":0,"parameters":["\"Series un gran governant! Estic segura d'això! "]},{"code":401,"indent":0,"parameters":["El poble ja t'adora!\""]},{"code":101,"indent":0,"parameters":["",0,0,0]},{"code":401,"indent":0,"parameters":[